#!/usr/bin/env bash
#
# Pre-push hook: run the Flutter test suite before allowing a push.
# Bypass in an emergency with:  git push --no-verify
set -euo pipefail

echo "[pre-push] sikka-flutter: running tests before push..."

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v flutter >/dev/null 2>&1; then
  echo "[pre-push] 'flutter' not found on PATH — cannot run tests. Push aborted."
  echo "[pre-push] Push from a terminal where 'flutter' works, or bypass with: git push --no-verify"
  exit 1
fi

if ! flutter test; then
  echo "[pre-push] Tests failed — push aborted."
  echo "[pre-push] Fix the failing tests, or bypass with: git push --no-verify"
  exit 1
fi

echo "[pre-push] Tests passed — proceeding with push."
